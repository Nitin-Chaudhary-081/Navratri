# Copy these into Render → navratri-backend → Environment (never commit real values).
PORT=4000
FRONTEND_URL=https://<your-app>.vercel.app
EVENT_ID=navratri-2026
# --- signing keys: generate with `yarn workspace backend keygen`, paste whole PEM (use \n for newlines) ---
ED25519_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ED25519_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# --- database: Supabase project → Connect → URI ---
DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<ref>.supabase.co:5432/postgres
# --- admin (pick strong values, solo = only you know these) ---
ADMIN_USER=admin
ADMIN_PASS=<long-random-password>
JWT_SECRET=<long-random-string>
# Demo operator password seed (memory mode only). PG uses the operators table.
# DEMO_OP_PASS=<random-string>
# --- Razorpay: Dashboard → Settings → API Keys (start with rzp_test_*) ---
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx
# --- ticket delivery: thank-you + ticket on buyer's channel (else console log only) ---
# Email: Gmail App Password (testing/small volume) or Resend (free 100/day, verified domain)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASS=xxxx xxxx xxxx xxxx
RESEND_API_KEY=re_xxx
RESEND_FROM=Navratri Garba 2026 <tickets@yourdomain.com>
# WhatsApp: Meta Cloud API number + approved template "navratri_pass"
# (4 body variables in order: buyer name, pass name, ticket id, ticket link)
WA_TOKEN=xxx
WA_PHONE_ID=xxx
WA_TEMPLATE=navratri_pass
WA_TEMPLATE_LANG=en
# --- DO NOT SET in production: ALLOW_ANY_GATE ---
